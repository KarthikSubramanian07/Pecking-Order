# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/
# Applied to static assets (including ones served through functions/_middleware.ts via next()
# or env.ASSETS). JSON-LD <script type="application/ld+json"> is a data block, which browsers
# never execute, so script-src 'self' does not block it. style-src needs 'unsafe-inline' for
# React style attributes and the inline loading-shell styles in index.html.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://upload.wikimedia.org https://*.wikimedia.org https://api.openverse.org https://raw.githubusercontent.com https://covers.openlibrary.org https://www.themealdb.com https://static.tvmaze.com; connect-src 'self' https://*.wikipedia.org https://*.wikimedia.org https://api.openverse.org https://upload.wikimedia.org https://raw.githubusercontent.com https://covers.openlibrary.org https://www.themealdb.com https://static.tvmaze.com; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml", </index.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain"
  Vary: Accept

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.md
  Content-Type: text/markdown; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# Preview deployments (<hash>.pecking-order.pages.dev) stay out of search results.
https://:deployment.pecking-order.pages.dev/*
  X-Robots-Tag: noindex
