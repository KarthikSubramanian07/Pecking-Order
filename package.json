{
  "name": "pecking-order",
  "version": "0.1.0",
  "private": true,
  "description": "Custom tier lists for anything. Rank it, share it, start a fight.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "npm run packs:build",
    "dev": "vite",
    "build": "npm run packs:build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run packs:build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pretest": "npm run packs:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "knip": "knip",
    "packs:build": "node scripts/build-packs.mjs",
    "packs:validate": "node scripts/build-packs.mjs --check",
    "packs:verify": "node scripts/verify-pack-images.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "brand": "node scripts/generate-brand-assets.mjs",
    "packs:covers": "node scripts/pack-covers.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "immer": "11.2.10",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "knip": "6.45.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
